# Phase 1 — Core (Traefik + Tailscale subnet router)
# Copy to .env and fill in values before running docker compose up.

# Base domain for all Traefik routing (e.g., home.example.com)
DOMAIN=home.example.com

# ACME / Let's Encrypt
ACME_EMAIL=admin@example.com

# Traefik dashboard basic auth (htpasswd -nb admin yourpassword)
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$...

# Tailscale
TAILSCALE_AUTH_KEY=tskey-auth-...

# LAN subnet to advertise into tailnet (subnet router mode)
LAN_SUBNET=192.168.1.0/24

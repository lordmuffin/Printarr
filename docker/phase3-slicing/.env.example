# Phase 3 — Headless Slicer
# Copy to .env and fill in values.

DOMAIN=home.example.com

# Static API key for slicer-api authentication (shared secret between services)
SLICER_API_KEY=changeme_strong_random_secret

# CIDR allowlist for Traefik IP middleware (LAN + tailnet)
SLICER_ALLOWED_CIDRS=192.168.1.0/24,100.64.0.0/10

# Phase 2 — Manyfold DAM
# Copy to .env and fill in values.

DOMAIN=home.example.com

# PostgreSQL connection string (external PG instance)
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://manyfold:changeme@192.168.1.5:5432/manyfold

# Rails secret key (generate with: openssl rand -hex 64)
SECRET_KEY_BASE=changeme_generate_with_openssl_rand_hex_64

# Google OAuth2 / OIDC credentials
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_OIDC_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OIDC_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

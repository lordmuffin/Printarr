# Phase 2 — Makers Vault DAM
# Copy to .env and fill in values.

DOMAIN=home.example.com

# Google OAuth2 credentials (same app registration as Manyfold or separate)
GOOGLE_OIDC_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OIDC_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Restrict login to users in this Google Workspace domain (use * to allow all)
GOOGLE_ALLOWED_DOMAIN=example.com

# oauth2-proxy cookie secret (generate with: openssl rand -base64 32)
OAUTH2_PROXY_COOKIE_SECRET=changeme_generate_with_openssl_rand_base64_32

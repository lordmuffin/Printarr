# Phase 5 — Fleet & AI (OctoEverywhere agent + AI vision sidecar)
# Copy to .env and fill in values.

DOMAIN=home.example.com

# Moonraker proxy host (LXC 230 IP or Tailscale hostname)
MOONRAKER_HOST=192.168.1.230
MOONRAKER_API_KEY=changeme

# CIDR allowlist for AI endpoint (LAN + tailnet only)
AI_ALLOWED_CIDRS=192.168.1.0/24,100.64.0.0/10

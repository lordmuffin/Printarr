# Phase 4 — Orchestration (Moonraker proxy + Spoolman + HomeBox)
# Copy to .env and fill in values.

DOMAIN=home.example.com

# Klipper host — IP of the printer RPi running Klipper+Moonraker
# Moonraker on LXC 230 proxies to this host
KLIPPY_HOST=192.168.1.50
KLIPPY_PORT=7125

# Moonraker API key (generate in Moonraker web UI after first start)
MOONRAKER_API_KEY=changeme

# Additional printer hosts (for multi-printer setups)
# PRINTER_2_HOST=192.168.1.51
# PRINTER_3_HOST=192.168.1.52

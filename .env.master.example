# ============================================================
# Printarr — Master Environment Variable Reference
# ============================================================
# This file documents ALL environment variables across all phases.
# Each phase directory has its own .env.example with only the
# variables relevant to that phase.
#
# Never commit a filled-in .env file — all .env files are in .gitignore.
# ============================================================

# ── Proxmox (used by OpenTofu) ───────────────────────────────────────────────
PROXMOX_ENDPOINT=https://192.168.1.10:8006
PROXMOX_API_TOKEN=terraform@pam!printarr=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PROXMOX_INSECURE=false
PROXMOX_NODE=pve
PROXMOX_SSH_USERNAME=root
PROXMOX_BRIDGE=vmbr0
PROXMOX_STORAGE_POOL=local-lvm
PROXMOX_LXC_TEMPLATE=ubuntu-24.04-standard_24.04-1_amd64.tar.zst
PROXMOX_TEMPLATE_STORAGE=local

# ── SSH ──────────────────────────────────────────────────────────────────────
SSH_PUBLIC_KEY=ssh-ed25519 AAAA... user@host

# ── Networking ───────────────────────────────────────────────────────────────
SUBNET_PREFIX=192.168.1        # LXC IPs: .200–.240
GATEWAY=192.168.1.1
DNS_SERVER=1.1.1.1
LAN_SUBNET=192.168.1.0/24

# ── Domain & TLS ─────────────────────────────────────────────────────────────
DOMAIN=home.example.com
ACME_EMAIL=admin@example.com

# ── Traefik ──────────────────────────────────────────────────────────────────
# Generate with: htpasswd -nb admin yourpassword
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$...

# ── PostgreSQL (external — shared by Manyfold) ───────────────────────────────
PG_HOST=192.168.1.5
PG_PORT=5432
PG_USER=manyfold
PG_PASSWORD=changeme
PG_DBNAME=manyfold
# Full DSN (used directly in Manyfold DATABASE_URL)
DATABASE_URL=postgresql://manyfold:changeme@192.168.1.5:5432/manyfold

# ── Google OAuth2 / OIDC ─────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_OIDC_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OIDC_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Restrict logins to this Google Workspace domain (use * for any Google account)
GOOGLE_ALLOWED_DOMAIN=example.com

# ── Manyfold ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=changeme_generate_with_openssl_rand_hex_64

# ── Makers Vault (oauth2-proxy) ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
OAUTH2_PROXY_COOKIE_SECRET=changeme_generate_with_openssl_rand_base64_32

# ── Slicer API ───────────────────────────────────────────────────────────────
SLICER_API_KEY=changeme_strong_random_secret
SLICER_ALLOWED_CIDRS=192.168.1.0/24

# ── Moonraker / Klipper ──────────────────────────────────────────────────────
# IP of the Raspberry Pi running Klipper (connected to printer via USB)
KLIPPY_HOST=192.168.1.50
KLIPPY_PORT=7125
# Moonraker API key (generated after first Moonraker start)
MOONRAKER_API_KEY=changeme

# For multi-printer setups, add additional PRINTER_N_HOST variables:
# PRINTER_2_HOST=192.168.1.51
# PRINTER_3_HOST=192.168.1.52

# ── Fleet & AI ───────────────────────────────────────────────────────────────
MOONRAKER_HOST=192.168.1.230
AI_ALLOWED_CIDRS=192.168.1.0/24
